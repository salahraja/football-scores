{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golboard.app/api/v1/schema.json",
  "title": "golboard API, version 1",
  "description": "The shape of every file under api/v1/. One file per type in $defs. Web pages and the iPhone app read these shapes; docs/api.md says what the fields mean.",
  "$defs": {
    "leagueId": { "type": "string", "pattern": "^[a-z]{2}-[0-9]$" },
    "season": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
    "teamId": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "goals": { "type": "integer", "minimum": 0, "maximum": 49 },
    "pair": { "type": "array", "prefixItems": [{ "$ref": "#/$defs/goals" }, { "$ref": "#/$defs/goals" }], "items": false, "minItems": 2 },
    "count": { "type": "integer", "minimum": 0 },

    "competitions": {
      "type": "object",
      "required": ["competitions"],
      "additionalProperties": false,
      "properties": {
        "competitions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "country", "seasons", "current"],
            "additionalProperties": false,
            "properties": {
              "id": { "$ref": "#/$defs/leagueId" },
              "name": { "type": "string", "minLength": 1 },
              "country": { "type": "string", "minLength": 1 },
              "seasons": { "type": "array", "items": { "$ref": "#/$defs/season" }, "minItems": 1 },
              "current": { "$ref": "#/$defs/season" }
            }
          }
        }
      }
    },

    "match": {
      "type": "object",
      "required": ["id", "round", "stage", "date", "time", "kickoff", "home", "away", "status", "score", "source"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "round": { "type": ["string", "null"] },
        "stage": { "enum": ["league", "playoffs"] },
        "date": { "$ref": "#/$defs/date" },
        "time": { "oneOf": [{ "type": "string", "pattern": "^[0-9]{2}:[0-9]{2}$" }, { "type": "null" }] },
        "kickoff": { "description": "The kick-off as an absolute time with the league's UTC offset, or null without a time.", "oneOf": [{ "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:00[+-][0-9]{2}:[0-9]{2}$" }, { "type": "null" }] },
        "home": { "$ref": "#/$defs/teamId" },
        "away": { "$ref": "#/$defs/teamId" },
        "status": { "enum": ["finished", "scheduled"] },
        "score": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["ft", "ht"],
              "additionalProperties": false,
              "properties": { "ft": { "$ref": "#/$defs/pair" }, "ht": { "oneOf": [{ "$ref": "#/$defs/pair" }, { "type": "null" }] } }
            }
          ]
        },
        "source": { "enum": ["openfootball", "correction", "wikipedia"] },
        "correctionSource": { "type": "string", "pattern": "^https://" },
        "sourceUrl": { "type": "string", "pattern": "^https://" }
      },
      "allOf": [
        { "if": { "properties": { "status": { "const": "finished" } } }, "then": { "properties": { "score": { "type": "object" } } } },
        { "if": { "properties": { "status": { "const": "scheduled" } } }, "then": { "properties": { "score": { "type": "null" } } } },
        { "if": { "properties": { "source": { "const": "correction" } } }, "then": { "required": ["correctionSource"] } },
        { "if": { "properties": { "source": { "const": "wikipedia" } } }, "then": { "required": ["sourceUrl"] } }
      ]
    },

    "matches": {
      "type": "object",
      "required": ["competition", "season", "matches"],
      "additionalProperties": false,
      "properties": {
        "competition": { "$ref": "#/$defs/leagueId" },
        "season": { "$ref": "#/$defs/season" },
        "matches": { "type": "array", "items": { "$ref": "#/$defs/match" } }
      }
    },

    "table": {
      "type": "object",
      "required": ["competition", "season", "table", "adjustments", "zones"],
      "additionalProperties": false,
      "properties": {
        "competition": { "$ref": "#/$defs/leagueId" },
        "season": { "$ref": "#/$defs/season" },
        "zones": {
          "description": "What each place leads to (data/api/zones.json), or null for a season without zones.",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["zones", "note"],
              "additionalProperties": false,
              "properties": {
                "zones": { "type": "array", "items": { "type": "object", "required": ["kind", "label", "from", "to"], "additionalProperties": false,
                  "properties": { "kind": { "type": "string" }, "label": { "type": "string" }, "from": { "type": "integer", "minimum": 1 }, "to": { "type": "integer", "minimum": 1 } } } },
                "note": { "type": "string" }
              }
            }
          ]
        },
        "table": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["position", "team", "played", "won", "drawn", "lost", "gf", "ga", "gd", "points", "adjustment"],
            "additionalProperties": false,
            "properties": {
              "position": { "type": "integer", "minimum": 1 },
              "team": { "$ref": "#/$defs/teamId" },
              "played": { "$ref": "#/$defs/count" },
              "won": { "$ref": "#/$defs/count" },
              "drawn": { "$ref": "#/$defs/count" },
              "lost": { "$ref": "#/$defs/count" },
              "gf": { "$ref": "#/$defs/count" },
              "ga": { "$ref": "#/$defs/count" },
              "gd": { "type": "integer" },
              "points": { "type": "integer" },
              "adjustment": { "type": "integer", "maximum": 0 }
            }
          }
        },
        "adjustments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["team", "points", "why", "source"],
            "additionalProperties": false,
            "properties": {
              "team": { "$ref": "#/$defs/teamId" },
              "points": { "type": "integer", "maximum": -1 },
              "why": { "type": "string", "minLength": 1 },
              "source": { "type": "string", "pattern": "^https://" }
            }
          }
        }
      }
    },

    "teams": {
      "type": "object",
      "required": ["competition", "season", "teams"],
      "additionalProperties": false,
      "properties": {
        "competition": { "$ref": "#/$defs/leagueId" },
        "season": { "$ref": "#/$defs/season" },
        "teams": { "type": "object", "propertyNames": { "$ref": "#/$defs/teamId" }, "additionalProperties": { "type": "string", "minLength": 1 } }
      }
    },

    "today": {
      "description": "Every league's games from the day before the build to three days after, in kick-off order, with team names: one small file for a widget.",
      "type": "object",
      "required": ["generatedAt", "from", "to", "matches"],
      "additionalProperties": false,
      "properties": {
        "generatedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" },
        "from": { "$ref": "#/$defs/date" },
        "to": { "$ref": "#/$defs/date" },
        "matches": { "type": "array", "items": { "type": "object", "required": ["league", "homeName", "awayName"],
          "properties": { "league": { "$ref": "#/$defs/leagueId" }, "homeName": { "type": "string" }, "awayName": { "type": "string" } } } }
      }
    },
    "news": {
      "description": "Football headlines from the publishers' own feeds (BBC Sport, The Guardian, ESPN), newest first, each with the clubs it mentions. A story is read at its link; only the headline, a short summary and a picture address are kept.",
      "type": "object",
      "required": ["generatedAt", "articles"],
      "additionalProperties": false,
      "properties": {
        "generatedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" },
        "articles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "url", "source", "published", "clubs"],
            "additionalProperties": false,
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "summary": { "type": ["string", "null"] },
              "url": { "type": "string", "pattern": "^https?://" },
              "source": { "type": "string" },
              "published": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" },
              "image": { "type": ["string", "null"], "pattern": "^https://" },
              "clubs": { "type": "array", "items": { "$ref": "#/$defs/teamId" }, "uniqueItems": true }
            }
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "required": ["version", "generatedAt", "sources", "leagues", "files"],
      "additionalProperties": false,
      "properties": {
        "version": { "const": 1 },
        "generatedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "url", "licence"],
            "additionalProperties": false,
            "properties": { "name": { "type": "string" }, "url": { "type": "string", "pattern": "^https://" }, "licence": { "type": "string" } }
          }
        },
        "leagues": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/leagueId" },
          "additionalProperties": {
            "type": "object",
            "propertyNames": { "$ref": "#/$defs/season" },
            "additionalProperties": {
              "type": "object",
              "required": ["finished", "scheduled", "lastResult", "corrections", "overdue"],
              "additionalProperties": false,
              "properties": {
                "finished": { "$ref": "#/$defs/count" },
                "scheduled": { "$ref": "#/$defs/count" },
                "lastResult": { "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
                "corrections": { "$ref": "#/$defs/count" },
                "overdue": { "description": "Games more than three days before the build with no result: a stalled source. npm run api:check fails while a current season has one.", "$ref": "#/$defs/count" },
                "wikipedia": {
                  "description": "The Wikipedia revision whose results grid scored games openfootball had not, how many, and any score the two disagree on (openfootball's is kept).",
                  "type": "object",
                  "required": ["revision", "filled", "disagreements"],
                  "additionalProperties": false,
                  "properties": {
                    "revision": { "type": "integer", "minimum": 1 },
                    "filled": { "$ref": "#/$defs/count" },
                    "disagreements": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["match", "openfootball", "wikipedia"],
                        "additionalProperties": false,
                        "properties": { "match": { "type": "string" }, "openfootball": { "$ref": "#/$defs/pair" }, "wikipedia": { "$ref": "#/$defs/pair" } }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "files": {
          "description": "Every other file of this build, by path, with the sha256 of its bytes.",
          "type": "object",
          "propertyNames": { "type": "string", "pattern": "^api/v1/" },
          "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
