{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golboard.app/api/v1/schema.json",
  "title": "golboard API, version 1",
  "description": "The shape of every file under api/v1/. One file per type in $defs. Web pages and the iPhone app read these shapes; docs/api.md says what the fields mean.",
  "$defs": {
    "leagueId": { "type": "string", "pattern": "^[a-z]{2}-[0-9]$" },
    "season": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
    "teamId": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "goals": { "type": "integer", "minimum": 0, "maximum": 49 },
    "pair": { "type": "array", "prefixItems": [{ "$ref": "#/$defs/goals" }, { "$ref": "#/$defs/goals" }], "items": false, "minItems": 2 },
    "count": { "type": "integer", "minimum": 0 },

    "competitions": {
      "type": "object",
      "required": ["competitions"],
      "additionalProperties": false,
      "properties": {
        "competitions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "country", "seasons", "current"],
            "additionalProperties": false,
            "properties": {
              "id": { "$ref": "#/$defs/leagueId" },
              "name": { "type": "string", "minLength": 1 },
              "country": { "type": "string", "minLength": 1 },
              "seasons": { "type": "array", "items": { "$ref": "#/$defs/season" }, "minItems": 1 },
              "current": { "$ref": "#/$defs/season" }
            }
          }
        }
      }
    },

    "match": {
      "type": "object",
      "required": ["id", "round", "stage", "date", "time", "kickoff", "home", "away", "status", "score", "source"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "round": { "type": ["string", "null"] },
        "stage": { "enum": ["league", "playoffs"] },
        "date": { "$ref": "#/$defs/date" },
        "time": { "oneOf": [{ "type": "string", "pattern": "^[0-9]{2}:[0-9]{2}$" }, { "type": "null" }] },
        "kickoff": { "description": "The kick-off as an absolute time with the league's UTC offset, or null without a time.", "oneOf": [{ "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:00[+-][0-9]{2}:[0-9]{2}$" }, { "type": "null" }] },
        "home": { "$ref": "#/$defs/teamId" },
        "away": { "$ref": "#/$defs/teamId" },
        "status": { "enum": ["finished", "scheduled"] },
        "score": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["ft", "ht"],
              "additionalProperties": false,
              "properties": { "ft": { "$ref": "#/$defs/pair" }, "ht": { "oneOf": [{ "$ref": "#/$defs/pair" }, { "type": "null" }] } }
            }
          ]
        },
        "source": { "enum": ["openfootball", "correction", "wikipedia"] },
        "correctionSource": { "type": "string", "pattern": "^https://" },
        "sourceUrl": { "type": "string", "pattern": "^https://" }
      },
      "allOf": [
        { "if": { "properties": { "status": { "const": "finished" } } }, "then": { "properties": { "score": { "type": "object" } } } },
        { "if": { "properties": { "status": { "const": "scheduled" } } }, "then": { "properties": { "score": { "type": "null" } } } },
        { "if": { "properties": { "source": { "const": "correction" } } }, "then": { "required": ["correctionSource"] } },
        { "if": { "properties": { "source": { "const": "wikipedia" } } }, "then": { "required": ["sourceUrl"] } }
      ]
    },

    "matches": {
      "type": "object",
      "required": ["competition", "season", "matches"],
      "additionalProperties": false,
      "properties": {
        "competition": { "$ref": "#/$defs/leagueId" },
        "season": { "$ref": "#/$defs/season" },
        "matches": { "type": "array", "items": { "$ref": "#/$defs/match" } }
      }
    },

    "table": {
      "type": "object",
      "required": ["competition", "season", "table", "adjustments", "zones"],
      "additionalProperties": false,
      "properties": {
        "competition": { "$ref": "#/$defs/leagueId" },
        "season": { "$ref": "#/$defs/season" },
        "zones": {
          "description": "What each place leads to (data/api/zones.json), or null for a season without zones.",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["zones", "note"],
              "additionalProperties": false,
              "properties": {
                "zones": { "type": "array", "items": { "type": "object", "required": ["kind", "label", "from", "to"], "additionalProperties": false,
                  "properties": { "kind": { "type": "string" }, "label": { "type": "string" }, "from": { "type": "integer", "minimum": 1 }, "to": { "type": "integer", "minimum": 1 } } } },
                "note": { "type": "string" }
              }
            }
          ]
        },
        "table": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["position", "team", "played", "won", "drawn", "lost", "gf", "ga", "gd", "points", "adjustment"],
            "additionalProperties": false,
            "properties": {
              "position": { "type": "integer", "minimum": 1 },
              "team": { "$ref": "#/$defs/teamId" },
              "played": { "$ref": "#/$defs/count" },
              "won": { "$ref": "#/$defs/count" },
              "drawn": { "$ref": "#/$defs/count" },
              "lost": { "$ref": "#/$defs/count" },
              "gf": { "$ref": "#/$defs/count" },
              "ga": { "$ref": "#/$defs/count" },
              "gd": { "type": "integer" },
              "points": { "type": "integer" },
              "adjustment": { "type": "integer", "maximum": 0 }
            }
          }
        },
        "adjustments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["team", "points", "why", "source"],
            "additionalProperties": false,
            "properties": {
              "team": { "$ref": "#/$defs/teamId" },
              "points": { "type": "integer", "maximum": -1 },
              "why": { "type": "string", "minLength": 1 },
              "source": { "type": "string", "pattern": "^https://" }
            }
          }
        }
      }
    },

    "teams": {
      "type": "object",
      "required": ["competition", "season", "teams"],
      "additionalProperties": false,
      "properties": {
        "competition": { "$ref": "#/$defs/leagueId" },
        "season": { "$ref": "#/$defs/season" },
        "teams": { "type": "object", "propertyNames": { "$ref": "#/$defs/teamId" }, "additionalProperties": { "type": "string", "minLength": 1 } }
      }
    },

    "leaders": {
      "description": "A league season's top scorers and goalkeepers' clean sheets, copied from the season's English Wikipedia page (not computed: we have no per-game scorers for the leagues). Either list is null when the page has none we can read; the file is left out when it has neither.",
      "type": "object",
      "required": ["competition", "season", "source", "goals", "cleanSheets"],
      "additionalProperties": false,
      "properties": {
        "competition": { "$ref": "#/$defs/leagueId" },
        "season": { "$ref": "#/$defs/season" },
        "source": { "type": "object", "required": ["name", "url", "licence"], "additionalProperties": false, "properties": {
          "name": { "const": "Wikipedia" }, "url": { "type": "string", "pattern": "^https://en\\.wikipedia\\.org/\\?oldid=[0-9]+$" }, "licence": { "const": "CC-BY-SA-4.0" } } },
        "goals": { "$ref": "#/$defs/leaderList" },
        "cleanSheets": { "$ref": "#/$defs/leaderList" }
      }
    },
    "leaderList": {
      "oneOf": [{ "type": "null" }, {
        "type": "object",
        "required": ["asOf", "rows"],
        "additionalProperties": false,
        "properties": {
          "asOf": { "description": "The date the page's editors say the list is up to; null when the page gives none.", "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
          "rows": { "type": "array", "minItems": 1, "items": {
            "type": "object",
            "required": ["rank", "player", "club", "team", "value"],
            "additionalProperties": false,
            "properties": {
              "rank": { "type": "integer", "minimum": 1 },
              "player": { "type": "string", "pattern": "^[^\\[\\]{}|<>=]+$" },
              "club": { "description": "The club as the page writes it.", "type": "string", "pattern": "^[^\\[\\]{}|<>=]+$" },
              "team": { "description": "Our id for the club, or null when no team this season has that name.", "oneOf": [{ "$ref": "#/$defs/teamId" }, { "type": "null" }] },
              "value": { "description": "Goals, or clean sheets.", "$ref": "#/$defs/count" }
            }
          } }
        }
      }]
    },

    "today": {
      "description": "Every league's and tournament's games from the day before the build to three days after, in kick-off order, with team names: one small file for a widget. league is the league's id or the tournament's (a club keeps one id in both, so a followed club's cup games are here too); a reader that does not know an id skips the game.",
      "type": "object",
      "required": ["generatedAt", "from", "to", "matches"],
      "additionalProperties": false,
      "properties": {
        "generatedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" },
        "from": { "$ref": "#/$defs/date" },
        "to": { "$ref": "#/$defs/date" },
        "matches": { "type": "array", "items": { "type": "object", "required": ["league", "homeName", "awayName"],
          "properties": { "league": { "anyOf": [{ "$ref": "#/$defs/leagueId" }, { "$ref": "#/$defs/tournamentId" }] }, "homeName": { "type": "string" }, "awayName": { "type": "string" } } } }
      }
    },
    "news": {
      "description": "Football headlines from the publishers' own feeds (BBC Sport, The Guardian, ESPN), newest first, each with the clubs it mentions. A story is read at its link; only the headline, a short summary and a picture address are kept.",
      "type": "object",
      "required": ["generatedAt", "articles"],
      "additionalProperties": false,
      "properties": {
        "generatedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" },
        "articles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "url", "source", "published", "clubs"],
            "additionalProperties": false,
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "summary": { "type": ["string", "null"] },
              "url": { "type": "string", "pattern": "^https?://" },
              "source": { "type": "string" },
              "published": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" },
              "image": { "type": ["string", "null"], "pattern": "^https://" },
              "clubs": { "type": "array", "items": { "$ref": "#/$defs/teamId" }, "uniqueItems": true }
            }
          }
        }
      }
    },
    "tournamentId": { "type": "string", "pattern": "^[a-z]+(-[a-z]+)*$" },
    "tournaments": {
      "description": "The international tournaments, played in groups. Kept apart from competitions.json, which lists club leagues with one table each.",
      "type": "object",
      "required": ["tournaments"],
      "additionalProperties": false,
      "properties": {
        "tournaments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "full", "region", "teams", "season", "finals"],
            "additionalProperties": false,
            "properties": {
              "id": { "$ref": "#/$defs/tournamentId" },
              "name": { "type": "string", "minLength": 1 },
              "full": { "type": "string", "minLength": 1 },
              "region": { "type": "string", "minLength": 1 },
              "teams": { "description": "Who plays: clubs or national teams.", "enum": ["clubs", "nations"] },
              "season": { "$ref": "#/$defs/season" },
              "finals": { "description": "Where and when the finals are played, in words.", "type": "string" }
            }
          }
        }
      }
    },
    "tournamentMatches": {
      "type": "object",
      "required": ["tournament", "season", "matches"],
      "additionalProperties": false,
      "properties": {
        "tournament": { "$ref": "#/$defs/tournamentId" },
        "season": { "$ref": "#/$defs/season" },
        "matches": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "round", "stage", "group", "date", "time", "kickoff", "home", "away", "status", "score", "source"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "round": { "type": "string", "minLength": 1 },
              "stage": { "const": "group" },
              "group": { "description": "The group's id: A, A1, or league for a single league-phase table.", "type": "string", "pattern": "^[A-Za-z0-9]+$" },
              "date": { "$ref": "#/$defs/date" },
              "time": { "oneOf": [{ "type": "string", "pattern": "^[0-9]{2}:[0-9]{2}$" }, { "type": "null" }] },
              "kickoff": {
                "description": "The kick-off as an absolute time with the venue's UTC offset (from the match box), or null without a time.",
                "oneOf": [{ "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:00[+-][0-9]{2}:[0-9]{2}$" }, { "type": "null" }]
              },
              "home": { "$ref": "#/$defs/teamId" },
              "away": { "$ref": "#/$defs/teamId" },
              "status": { "enum": ["finished", "scheduled"] },
              "score": {
                "oneOf": [
                  { "type": "null" },
                  { "type": "object", "required": ["ft", "ht"], "additionalProperties": false, "properties": { "ft": { "$ref": "#/$defs/pair" }, "ht": { "type": "null" } } }
                ]
              },
              "source": { "const": "wikipedia" }
            }
          }
        }
      }
    },
    "groups": {
      "type": "object",
      "required": ["tournament", "season", "zones", "hosts", "groups"],
      "additionalProperties": false,
      "properties": {
        "tournament": { "$ref": "#/$defs/tournamentId" },
        "season": { "$ref": "#/$defs/season" },
        "zones": {
          "description": "What each place leads to, for every group (division null) or one division's groups (Nations League A, B...).",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "label", "from", "to", "division"],
            "additionalProperties": false,
            "properties": {
              "kind": { "type": "string", "pattern": "^[a-z0-9_]+$" },
              "label": { "type": "string", "minLength": 1 },
              "from": { "type": "integer", "minimum": 1 },
              "to": { "type": "integer", "minimum": 1 },
              "division": { "oneOf": [{ "type": "string" }, { "type": "null" }] }
            }
          }
        },
        "hosts": { "description": "Nations already in the finals as hosts.", "type": "array", "items": { "$ref": "#/$defs/teamId" } },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["group", "name", "division", "table"],
            "additionalProperties": false,
            "properties": {
              "group": { "type": "string", "pattern": "^[A-Za-z0-9]+$" },
              "name": { "type": "string", "minLength": 1 },
              "division": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
              "table": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["position", "team", "played", "won", "drawn", "lost", "gf", "ga", "gd", "points", "adjustment", "status"],
                  "additionalProperties": false,
                  "properties": {
                    "position": { "type": "integer", "minimum": 1 },
                    "team": { "$ref": "#/$defs/teamId" },
                    "played": { "$ref": "#/$defs/count" },
                    "won": { "$ref": "#/$defs/count" },
                    "drawn": { "$ref": "#/$defs/count" },
                    "lost": { "$ref": "#/$defs/count" },
                    "gf": { "$ref": "#/$defs/count" },
                    "ga": { "$ref": "#/$defs/count" },
                    "gd": { "type": "integer" },
                    "points": { "type": "integer" },
                    "adjustment": { "type": "integer" },
                    "status": { "description": "The zone the place falls in (a kind from zones), host (in the finals already as a host), or null.", "oneOf": [{ "type": "string", "pattern": "^[a-z0-9_]+$" }, { "type": "null" }] }
                  }
                }
              }
            }
          }
        }
      }
    },
    "tournamentTeams": {
      "type": "object",
      "required": ["tournament", "season", "teams"],
      "additionalProperties": false,
      "properties": {
        "tournament": { "$ref": "#/$defs/tournamentId" },
        "season": { "$ref": "#/$defs/season" },
        "teams": { "type": "object", "propertyNames": { "$ref": "#/$defs/teamId" }, "additionalProperties": { "type": "string", "minLength": 1 } }
      }
    },
    "meta": {
      "type": "object",
      "required": ["version", "generatedAt", "sources", "leagues", "tournaments", "files"],
      "additionalProperties": false,
      "properties": {
        "version": { "const": 1 },
        "generatedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "url", "licence"],
            "additionalProperties": false,
            "properties": { "name": { "type": "string" }, "url": { "type": "string", "pattern": "^https://" }, "licence": { "type": "string" } }
          }
        },
        "leagues": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/leagueId" },
          "additionalProperties": {
            "type": "object",
            "propertyNames": { "$ref": "#/$defs/season" },
            "additionalProperties": {
              "type": "object",
              "required": ["finished", "scheduled", "lastResult", "corrections", "overdue"],
              "additionalProperties": false,
              "properties": {
                "finished": { "$ref": "#/$defs/count" },
                "scheduled": { "$ref": "#/$defs/count" },
                "lastResult": { "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
                "corrections": { "$ref": "#/$defs/count" },
                "overdue": { "description": "Games more than three days before the build with no result: a stalled source. npm run api:check fails while a current season has one.", "$ref": "#/$defs/count" },
                "wikipedia": {
                  "description": "The Wikipedia revision whose results grid scored games openfootball had not, how many, and any score the two disagree on (openfootball's is kept).",
                  "type": "object",
                  "required": ["revision", "filled", "disagreements"],
                  "additionalProperties": false,
                  "properties": {
                    "revision": { "type": "integer", "minimum": 1 },
                    "filled": { "$ref": "#/$defs/count" },
                    "disagreements": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["match", "openfootball", "wikipedia"],
                        "additionalProperties": false,
                        "properties": { "match": { "type": "string" }, "openfootball": { "$ref": "#/$defs/pair" }, "wikipedia": { "$ref": "#/$defs/pair" } }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "tournaments": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/tournamentId" },
          "additionalProperties": {
            "type": "object",
            "propertyNames": { "$ref": "#/$defs/season" },
            "additionalProperties": {
              "type": "object",
              "required": ["finished", "scheduled", "lastResult", "overdue", "wikipedia"],
              "additionalProperties": false,
              "properties": {
                "finished": { "$ref": "#/$defs/count" },
                "scheduled": { "$ref": "#/$defs/count" },
                "lastResult": { "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
                "overdue": { "$ref": "#/$defs/count" },
                "wikipedia": { "description": "Each Wikipedia page's revision, by title.", "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } }
              }
            }
          }
        },
        "files": {
          "description": "Every other file of this build, by path, with the sha256 of its bytes.",
          "type": "object",
          "propertyNames": { "type": "string", "pattern": "^api/v1/" },
          "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
