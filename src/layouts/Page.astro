---
// Every app page: the head, the glass nav, and the page in <main>.
import "../styles/tokens.css";
import "../styles/base.css";
import NavBar from "../components/NavBar.vue";

interface Props { title: string; current: string; description?: string }
const { title, current, description = "Serie A scores, results and league table" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- opened from the Home Screen, golboard runs as an app of its own, with no Safari bar or side strip (Salah, 2026-11-25) -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="golboard" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <!-- the poster is sized for this font: fetched first, so the first frame is not drawn in a wide fallback (look audit 2026-11-18) -->
    <link rel="preload" href="/fonts/barlow-condensed-800-latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <script is:inline src="/theme-toggle.js" defer></script>
    <script is:inline src="/poster-font.js" defer></script>
  </head>
  <body>
    <div id="app">
      <NavBar current={current} />
      <main class="page"><slot /></main>
    </div>
  </body>
</html>
