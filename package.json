{
  "name": "football-scores",
  "version": "0.2.0",
  "private": true,
  "engines": { "node": ">=22.23" },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:tsrs": "tsrs --noEmit",
    "data": "sh scripts/data.sh",
    "data:ts": "DATA_ENGINE=ts sh scripts/data.sh",
    "data:fetch": "node scripts/fetch-data.mjs",
    "build:data": "npm run data && VITE_DATA=generated npm run build",
    "build:live": "node scripts/fetch-data.mjs && npm run data && VITE_DATA=generated npm run build",
    "goose:build": "sh goose/build.sh",
    "goose:wasm": "sh goose/wasm/build.sh",
    "parity": "node scripts/parity.mjs python && node scripts/parity.mjs goose && node scripts/parity.mjs wasm",
    "test:python": "python3 -I -m unittest discover -s python"
  },
  "dependencies": {
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.0",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "~5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "vue-tsc": "^2.2.0"
  }
}
